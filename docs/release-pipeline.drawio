          <mxGeometry height="150" width="438" x="30" y="1016" as="geometry" />
        </mxCell>
        <mxCell id="n81" parent="1" style="fontFamily=Segoe UI;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E6EC;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#1F2937;font-size:13px&quot;&gt;What each new check catches&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.4&quot;&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;G2 rules&lt;/b&gt;: data processed in the wrong country, filters off&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;G4 personas&lt;/b&gt;: the right answer shown to the wrong person&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;RAI checks&lt;/b&gt;: personal data leaks, made-up answers&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;UAT&lt;/b&gt;: correct but not useful (Foundry human-eval evidence)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="438" x="481" y="1016" as="geometry" />
        </mxCell>
        <mxCell id="n82" parent="1" style="fontFamily=Segoe UI;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E6EC;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#1F2937;font-size:13px&quot;&gt;Built into every gate&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.4&quot;&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Fail closed: errors or missing results block, never pass&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;A real miss is not retried; judge errors are re-scored (max 4)&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Results reused when nothing changed (dev version, eval, red team)&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;OIDC login, pinned actions, tag rules, no admin bypass&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="438" x="932" y="1016" as="geometry" />
        </mxCell>
