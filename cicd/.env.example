# Copy to cicd/.env for local runs (gitignored). In GitHub Actions set the same names as
# secrets on each GitHub Environment (dev, test, prod, prod-monitor); real environment variables override this file.

# Foundry project that hosts the agent
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>

# Hosted agents only: the environment's container registry login server (a GitHub Environment variable in Actions)
# AZURE_CONTAINER_REGISTRY=<registry>.azurecr.io
