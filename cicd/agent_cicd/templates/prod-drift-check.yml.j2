# Daily check that prod still runs exactly what the last release approved (diagram: "Drift & monitoring").
# Generated from cicd/agents/{= agent =}/pipeline.yaml by `python -m agent_cicd.generate`: edit that file, not this one.
# Uses the prod identity through the `prod-monitor` environment (no reviewer, main branch only) and only reads.
name: {= agent =}-prod-drift-check

on:
{% if drift_cron %}
  schedule:
    - cron: "{= drift_cron =}"
{% endif %}
  workflow_dispatch:

permissions:
  id-token: write
  contents: read
  issues: write
  deployments: read

jobs:
  drift:
    name: Prod drift check
    # Scheduled runs start once prod is live: set the repository variable ENABLE_PROD_DRIFT_CHECK to "true".
    if: github.event_name != 'schedule' || vars.ENABLE_PROD_DRIFT_CHECK == 'true'
    runs-on: ubuntu-latest
    environment: prod-monitor
    env:
      AGENT_DIR: agents/{= agent =}
      FOUNDRY_PROJECT_ENDPOINT: ${{ secrets.FOUNDRY_PROJECT_ENDPOINT }}
      AZURE_CONTAINER_REGISTRY: ${{ vars.AZURE_CONTAINER_REGISTRY }}
    defaults:
      run:
        working-directory: cicd
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          fetch-depth: 0
      # Baseline = the last {= agent =} release tag the `prod` environment deployed successfully (a newer tag may still be waiting
      # for sign-off, or may have been rejected or rolled back). Other agents deploy to `prod` too, so only this agent's tags count.
      # Pipeline code stays on main.
      - name: Use the agent files from the last successful prod deployment
        id: tag
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          tag=""
          for id in $(gh api "repos/${GITHUB_REPOSITORY}/deployments?environment=prod&per_page=100" \
                      --jq '.[] | select(.ref | startswith("{= tag_prefix =}")) | .id'); do
            state=$(gh api "repos/${GITHUB_REPOSITORY}/deployments/${id}/statuses?per_page=1" --jq '.[0].state // ""')
            if [ "$state" = "success" ]; then
              tag=$(gh api "repos/${GITHUB_REPOSITORY}/deployments/${id}" --jq '.ref'); break
            fi
          done
          [ -n "$tag" ] || { echo "::error::No successful prod deployment of a {= tag_prefix =}* release found"; exit 1; }
          git fetch --tags --quiet
          git checkout "$tag" -- "$AGENT_DIR/agent.json" "$AGENT_DIR/instructions.md" "$AGENT_DIR/config/prod.json"
          echo "tag=$tag" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: cicd/requirements.txt
      - run: pip install -r requirements.txt
      - uses: azure/login@7184910d9eb2b1c5e48f7073824a90609bb9b6d6 # v2.3.1
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      - name: Compare prod with the release
        id: drift
        run: |
          python -m agent_cicd.drift --agent-dir "$AGENT_DIR" --env prod --ref "${{ steps.tag.outputs.tag }}" --report out/drift.json
          cp "$GITHUB_STEP_SUMMARY" out/drift.md
      - name: Open, update or close the drift issue
        env:
          GH_TOKEN: ${{ github.token }}
          DRIFT: ${{ steps.drift.outputs.drift }}
        run: |
          title="Prod drift: ${AGENT_DIR#agents/}"
          gh label create drift --color d93f0b --description "Prod differs from the last release" 2>/dev/null || true
          number=$(gh issue list --state open --label drift --json number,title \
            --jq ".[] | select(.title == \"$title\") | .number" | head -n1)
          if [ "$DRIFT" = "drift" ]; then
            if [ -z "$number" ]; then gh issue create --title "$title" --label drift --body-file out/drift.md
            else gh issue comment "$number" --body-file out/drift.md; fi
          elif [ -n "$number" ]; then
            gh issue close "$number" --comment "Prod matches ${{ steps.tag.outputs.tag }} again."
          fi